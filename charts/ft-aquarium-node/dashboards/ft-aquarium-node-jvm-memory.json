  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Kernel view — what the OOM killer sees",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Working set and RSS vs limit vs request",
      "description": "Answers: how close is the app container to its memory limit, and how much of the request does it use? container_memory_working_set_bytes is the number the kernel's OOM killer acts on — when it reaches the limit (dashed red) the container is killed, whatever the JVM thinks of its heap. RSS is shown for comparison; the working set also counts active page cache. The request (dashed orange) is what the scheduler reserves, not a cap. Size the limit from the PEAK working set over a window that includes a sync, a cursor-cleanup run and liquidation/compound runs — see README §8. Container is the app container, named after the chart.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*request$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container=\"ft-aquarium-node\"})",
          "legendFormat": "{{pod}} working set",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (container_memory_rss{namespace=\"$namespace\", pod=~\"$pod\", container=\"ft-aquarium-node\"})",
          "legendFormat": "{{pod}} rss",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_limits{namespace=\"$namespace\", pod=~\"$pod\", container=\"ft-aquarium-node\", resource=\"memory\"})",
          "legendFormat": "{{pod}} limit",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (kube_pod_container_resource_requests{namespace=\"$namespace\", pod=~\"$pod\", container=\"ft-aquarium-node\", resource=\"memory\"})",
          "legendFormat": "{{pod}} request",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "id": 3,
      "title": "JVM heap — what the application actually keeps",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Heap: used / committed / max",
      "description": "Answers: how much heap the JVM has reserved from the OS (committed) against how much it is using right now (used) and the ceiling MaxRAMPercentage gave it (max). Used is a sawtooth: its peaks are garbage waiting to be collected, not demand — size the heap from the live set panel, not from this one. Summed over area=\"heap\" pools, so it reads the same under Serial and G1 (pools with an undefined max, reported as -1, are left out).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*max$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_memory_used_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=\"heap\"}))",
          "legendFormat": "{{pod}} used",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_memory_committed_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=\"heap\"}))",
          "legendFormat": "{{pod}} committed",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_memory_max_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=\"heap\"} > 0))",
          "legendFormat": "{{pod}} max",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Live set after major GC",
      "description": "Answers: how much heap is really live — the data that survives a full collection. This is the number the heap is sized from (heap ≈ peak live set × 2–3). CAVEAT: jvm_gc_live_data_size_bytes is updated only after a MAJOR collection, so between major GCs it is stale — a flat line can mean nothing has been measured lately, not that nothing changed. Check the 'Collections by action' panel beside it: if there are no major collections in the window, this value is old. Max data size is the old generation's ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*max$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_gc_live_data_size_bytes{namespace=\"$namespace\", pod=~\"$pod\"}))",
          "legendFormat": "{{pod}} live data after major GC",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_gc_max_data_size_bytes{namespace=\"$namespace\", pod=~\"$pod\"}))",
          "legendFormat": "{{pod}} old generation max",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Heap usage after GC (long-lived pool)",
      "description": "Answers: after the last collection, what fraction of the long-lived (old generation) heap pool is still occupied? jvm_memory_usage_after_gc is a 0–1 ratio. A floor that climbs from one collection to the next and stays near 1 is a heap that is too small, or a leak; a floor well below 1 at the peak of a sync is headroom you can give back.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (namespace, pod) (jvm_memory_usage_after_gc{namespace=\"$namespace\", pod=~\"$pod\", area=\"heap\"})",
          "legendFormat": "{{pod}} usage after GC",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Collections by action",
      "description": "Answers: when did major (full) collections actually happen? Read it beside the live set panel: jvm_gc_live_data_size_bytes only moves after a major collection, so a window with no 'end of major GC' here is a window where the live set was not re-measured.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod, action) (max without (instance, job, service, endpoint) (increase(jvm_gc_pause_seconds_count{namespace=\"$namespace\", pod=~\"$pod\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{action}}",
          "range": true
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Off-heap — the part MaxRAMPercentage does not cover",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Non-heap by pool",
      "description": "Answers: how much memory sits outside the heap in JVM-managed pools — Metaspace, Compressed Class Space and the code heaps. These do not shrink with the heap and must fit in limit − heap. Committed (total) is what the sizing method adds on top of the heap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod, id) (max without (instance, job, service, endpoint) (jvm_memory_used_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=\"nonheap\"}))",
          "legendFormat": "{{id}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_memory_committed_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=\"nonheap\"}))",
          "legendFormat": "committed (total)",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Direct and mapped buffers",
      "description": "Answers: how much memory NIO buffers hold outside the heap (direct, mapped). Netty, JDBC drivers and file I/O allocate here; it counts against the container limit and not against the heap.",
