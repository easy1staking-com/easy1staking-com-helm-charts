          "uid": "${datasource}"
        },
        "definition": "label_values(jvm_info, namespace)",
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_info, namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
