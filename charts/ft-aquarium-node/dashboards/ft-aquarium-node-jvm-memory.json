    {
      "type": "timeseries",
      "id": 12,
      "title": "Unaccounted native memory",
      "description": "Answers: how much of the container's working set is NOT explained by the JVM's own metrics — working set − (heap committed + non-heap committed + buffers used). The remainder is thread stacks, malloc arenas, GC bookkeeping, JIT scratch space and anything else the JVM metrics do not show. It belongs in the limit; it is the usual cause of an OOMKill with no Java OutOfMemoryError. Approximate: the working set also counts active page cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container=\"ft-aquarium-node\"}) - sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_memory_committed_bytes{namespace=\"$namespace\", pod=~\"$pod\", area=~\"heap|nonheap\"})) - sum by (namespace, pod) (max without (instance, job, service, endpoint) (jvm_buffer_memory_used_bytes{namespace=\"$namespace\", pod=~\"$pod\"}))",
          "legendFormat": "{{pod}} unaccounted",
          "range": true
        }
      ]
    },
